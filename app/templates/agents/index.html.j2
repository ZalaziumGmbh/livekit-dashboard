{% extends "base.html.j2" %}

{% block title %}Agents - LiveKit Dashboard{% endblock %}

{% block page_title %}Agents{% endblock %}

{% block page_subtitle %}
<p class="page-subtitle">Configured agents from SIP dispatch rules</p>
{% endblock %}

{% block content %}
<!-- Stats -->
<div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
    <div class="stat-card">
        <div class="stat-label">
            <i class="bi bi-robot"></i> Configured Agents
        </div>
        <div class="stat-value info">
            {{ agents|length }}
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-label">
            <i class="bi bi-activity"></i> Active Sessions
        </div>
        <div class="stat-value success">
            {{ active_count }}
        </div>
    </div>
</div>

<!-- Agents Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title">
            <i class="bi bi-robot"></i> Your Agents
        </h5>
        <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
    </div>
    <div class="card-body">
        {% if agents %}
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Agent Name</th>
                        <th>Status</th>
                        <th>Linked Rule</th>
                    </tr>
                </thead>
                <tbody>
                    {% for agent in agents %}
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-robot me-2" style="font-size: 1.25rem; color: var(--text-secondary);"></i>
                                <strong style="color: var(--text-primary);">{{ agent.name }}</strong>
                            </div>
                        </td>
                        <td>
                            {% if agent.is_active %}
                            <span class="badge bg-success">
                                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> ACTIVE
                            </span>
                            {% else %}
                            <span class="badge bg-secondary">
                                <i class="bi bi-circle me-1" style="font-size: 0.5rem;"></i> IDLE
                            </span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="/sip-inbound" class="text-info">
                                <i class="bi bi-telephone-inbound"></i> {{ agent.rule_name }}
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-robot"></i>
            </div>
            <div class="empty-state-title">No agents configured</div>
            <div class="empty-state-description">
                Configure agents in your <a href="/sip-inbound" class="text-info">Inbound Rules</a> to see them here.
            </div>
        </div>
        {% endif %}
    </div>
</div>

<!-- Help Section -->
<div class="card mt-4">
    <div class="card-header">
        <h5 class="card-title">
            <i class="bi bi-info-circle"></i> How Agents Work
        </h5>
    </div>
    <div class="card-body">
        <p class="text-muted mb-2">
            Agents are configured in your <strong>Inbound Rules</strong>. When a call comes in:
        </p>
        <ol class="text-muted mb-0" style="padding-left: 1.25rem;">
            <li>LiveKit creates a room for the call</li>
            <li>Your agent worker receives a job dispatch</li>
            <li>Agent joins the room and handles the call</li>
            <li>Status changes to <span class="badge bg-success">ACTIVE</span></li>
        </ol>
    </div>
</div>
{% endblock %}
