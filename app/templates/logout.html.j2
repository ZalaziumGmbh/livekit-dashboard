<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Logout - LiveKit Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
        }
        .card {
            background: #1e1e2f;
            border: 1px solid #2d2d44;
        }
        .card-body {
            color: #e0e0e0;
        }
        .text-muted {
            color: #8888aa !important;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center mt-5">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-box-arrow-right text-warning" style="font-size: 4rem;"></i>
                        <h1 class="mt-3">Confirm Logout</h1>
                        <p class="lead">Are you sure you want to log out?</p>
                        <p class="text-muted">
                            You will need to enter your credentials again to access the dashboard.
                        </p>
                        <div class="mt-4">
                            <a href="/logout?confirmed=true" class="btn btn-danger me-2">
                                <i class="bi bi-box-arrow-right"></i> Yes, Log Out
                            </a>
                            <a href="/" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
