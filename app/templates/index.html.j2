{% extends "base.html.j2" %}

{% block title %}Overview - LiveKit Dashboard{% endblock %}

{% block page_header %}
<div class="d-flex justify-content-between align-items-center w-100">
    <div>
        <h1 class="page-title">Overview</h1>
        <p class="page-subtitle">SIP Telephony Dashboard</p>
    </div>
    <button class="btn btn-sm btn-secondary" onclick="location.reload()">
        <i class="bi bi-arrow-clockwise"></i> Refresh
    </button>
</div>
{% endblock %}

{% block content %}
<!-- SIP Stats -->
{% if sip_enabled and sip_analytics %}
<div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
    <div class="stat-card">
        <div class="stat-label">
            <i class="bi bi-diagram-3"></i> Inbound Trunks
        </div>
        <div class="stat-value info">
            {{ sip_analytics.inbound_trunks }}
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-label">
            <i class="bi bi-diagram-3"></i> Outbound Trunks
        </div>
        <div class="stat-value info">
            {{ sip_analytics.outbound_trunks }}
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-label">
            <i class="bi bi-list-check"></i> Dispatch Rules
        </div>
        <div class="stat-value success">
            {{ sip_analytics.dispatch_rules }}
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-label">
            <i class="bi bi-robot"></i> Configured Agents
        </div>
        <div class="stat-value">
            {{ configured_agents|length }}
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="card mt-4">
    <div class="card-header">
        <h5 class="card-title">
            <i class="bi bi-lightning"></i> Quick Actions
        </h5>
    </div>
    <div class="card-body">
        <div class="d-flex gap-3 flex-wrap">
            <a href="/sip-outbound" class="btn btn-primary">
                <i class="bi bi-telephone-outbound"></i> Manage Outbound Trunks
            </a>
            <a href="/sip-inbound" class="btn btn-primary">
                <i class="bi bi-telephone-inbound"></i> Manage Inbound Rules
            </a>
            <a href="/agents" class="btn btn-secondary">
                <i class="bi bi-robot"></i> View Agents
            </a>
        </div>
    </div>
</div>

<!-- Active Calls -->
<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title">
            <i class="bi bi-telephone"></i> Active Calls
        </h5>
        <span class="badge bg-{{ 'success' if active_rooms > 0 else 'secondary' }}">
            {{ active_rooms }} active
        </span>
    </div>
    <div class="card-body">
        {% if active_rooms > 0 %}
        <p class="text-muted">
            There are currently <strong>{{ active_rooms }}</strong> active call rooms with
            <strong>{{ total_participants }}</strong> participants.
        </p>
        {% else %}
        <div class="empty-state" style="padding: 2rem 0;">
            <div class="empty-state-icon">
                <i class="bi bi-telephone-x"></i>
            </div>
            <div class="empty-state-title">No active calls</div>
            <div class="empty-state-description">
                Calls will appear here when someone dials your SIP trunk.
            </div>
        </div>
        {% endif %}
    </div>
</div>

<!-- Configured Agents -->
<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title">
            <i class="bi bi-robot"></i> Configured Agents
        </h5>
        <a href="/agents" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <div class="card-body">
        {% if configured_agents %}
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Agent Name</th>
                        <th>Linked Rule</th>
                    </tr>
                </thead>
                <tbody>
                    {% for agent in configured_agents[:5] %}
                    <tr>
                        <td>
                            <i class="bi bi-robot me-2" style="color: var(--text-secondary);"></i>
                            <strong>{{ agent.name }}</strong>
                        </td>
                        <td>
                            <span class="text-muted">{{ agent.rule_name }}</span>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if configured_agents|length > 5 %}
        <p class="text-muted mt-2 mb-0">
            <small>Showing 5 of {{ configured_agents|length }} agents. <a href="/agents">View all</a></small>
        </p>
        {% endif %}
        {% else %}
        <div class="empty-state" style="padding: 2rem 0;">
            <div class="empty-state-icon">
                <i class="bi bi-robot"></i>
            </div>
            <div class="empty-state-title">No agents configured</div>
            <div class="empty-state-description">
                Add an agent to your <a href="/sip-inbound">Inbound Rules</a> to handle calls automatically.
            </div>
        </div>
        {% endif %}
    </div>
</div>

{% else %}
<!-- SIP Not Enabled -->
<div class="card">
    <div class="card-body">
        <div class="empty-state" style="padding: 3rem 0;">
            <div class="empty-state-icon">
                <i class="bi bi-telephone-x"></i>
            </div>
            <div class="empty-state-title">SIP Telephony Not Enabled</div>
            <div class="empty-state-description">
                Set <code>ENABLE_SIP=true</code> in your environment to enable SIP telephony features.
            </div>
        </div>
    </div>
</div>
{% endif %}

<!-- Server Info -->
<div class="card mt-4">
    <div class="card-header">
        <h5 class="card-title">
            <i class="bi bi-server"></i> Server Info
        </h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p class="mb-2">
                    <strong>LiveKit URL:</strong>
                    <code>{{ server_info.url or 'Not configured' }}</code>
                </p>
                <p class="mb-0">
                    <strong>Status:</strong>
                    <span class="badge bg-{{ 'success' if server_info.is_connected else 'danger' }}">
                        {{ 'Connected' if server_info.is_connected else 'Disconnected' }}
                    </span>
                </p>
            </div>
            <div class="col-md-6">
                <p class="mb-2">
                    <strong>SIP Enabled:</strong>
                    <span class="badge bg-{{ 'success' if sip_enabled else 'secondary' }}">
                        {{ 'Yes' if sip_enabled else 'No' }}
                    </span>
                </p>
                <p class="mb-0">
                    <strong>API Latency:</strong>
                    {{ server_info.sdk_latency_ms or '?' }} ms
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
